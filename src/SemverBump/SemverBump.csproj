<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Dotnet Tool configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>llm-semver-bump</ToolCommandName>
    <PackageId>LlmSemverBump</PackageId>
    <Version>1.0.0</Version>
    <Authors>Martin Andersen</Authors>
    <Description>AI-powered semantic versioning tool. Analyzes git commits and diffs using Claude to determine the correct semver bump (major/minor/patch) for your NuGet packages.</Description>
    <PackageTags>semver;versioning;ai;claude;nuget;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.9.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
